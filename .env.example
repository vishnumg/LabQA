# Backend/Functions
DATABASE_URL=postgres://user:password@host:5432/dbname
JWT_SECRET=replace-with-long-random-secret

# Frontend (Next.js) - set this in Vercel Project Environment Variables
# Base URL of the FastAPI backend (no trailing slash). Example: https://labqa-backend.example.com
NEXT_PUBLIC_API_BASE=https://labqa-backend.example.com

# (Optional) If you deploy backend behind a different path prefix, adjust rewrites accordingly
# NEXT_PUBLIC_BUILD_SHA will be injected by CI if desired
NEXT_PUBLIC_BUILD_SHA=local-dev

# ------------------------------------------------------------
# Google OAuth (Docs/Drive export)
# Obtain these by creating an "OAuth Client ID" (Web application) in Google Cloud Console.
# NEVER commit real secrets. For local dev you can place them in a non-committed .env file.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-secret
# The redirect URI MUST exactly match one registered in the Google Cloud Console.
# It should point to the FastAPI callback endpoint (served by your backend domain):
#   e.g. https://your-backend-domain/api/google/oauth/callback
GOOGLE_REDIRECT_URI=https://localhost:8000/api/google/oauth/callback

# Origin of the frontend used for postMessage security in OAuth popup callback
FRONTEND_ORIGIN=http://localhost:3000

# (Optional) Development helper to bypass interactive OAuth when manually testing gdoc export
# DEV_GOOGLE_ACCESS_TOKEN_OVERRIDE=ya29....
